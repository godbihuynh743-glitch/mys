local SpeedVal = 16
local JumpVal = 50
local Flying = false
local FlySpeed = 50

task.spawn(function()
    while task.wait(0.1) do
        pcall(function()
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                local hum = LocalPlayer.Character.Humanoid
                hum.WalkSpeed = SpeedVal
                hum.UseJumpPower = true
                hum.JumpPower = JumpVal
            end
        end)
    end
end)

Tabs.Movement:AddSlider("SpeedSlider", {
    Title = "Tốc Độ Di Chuyển (Speed)",
    Min = 16, Max = 300, Default = 16, Decimals = 0,
    Callback = function(v) SpeedVal = v end
})

Tabs.Movement:AddSlider("JumpSlider", {
    Title = "Độ Cao Nhảy (Jump)",
    Min = 50, Max = 300, Default = 50, Decimals = 0,
    Callback = function(v) JumpVal = v end
})

Tabs.Movement:AddToggle("FlyToggle", {
    Title = "Bay Theo Camera (Fly)",
    Default = false,
    Callback = function(v)
        Flying = v
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local hrp = char.HumanoidRootPart
        
        if Flying then
            local bv = Instance.new("BodyVelocity")
            bv.Name = "FlyVelocity"
            bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
            bv.Parent = hrp
            
            task.spawn(function()
                while Flying and hrp:FindFirstChild("FlyVelocity") do
                    bv.Velocity = Camera.CFrame.LookVector * FlySpeed
                    task.wait()
                end
                bv:Destroy()
            end)
        end
    end
})

Tabs.Movement:AddSlider("FlySpeedSlider", {
    Title = "Tốc Độ Bay",
    Min = 20, Max = 200, Default = 50, Decimals = 0,
    Callback = function(v) FlySpeed = v end
})

