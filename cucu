camLockButton = Instance.new("TextButton")
camLockButton.Name = "CamLockButton"
camLockButton.Size = UDim2.new(0.5, -13, 0, 26)
camLockButton.Position = UDim2.fromOffset(10, 222)
camLockButton.BackgroundColor3 = GRAY
