--====================================================
-- HELPERS
--====================================================

local function getRoot(player)
	local character = player and player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid(player)
	local character = player and player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function clearHighlight()
	if targetHighlight then
		targetHighlight:Destroy()
		targetHighlight = nil
	end
end

local function stopFollow()
	following = false
	if followConnection then
		followConnection:Disconnect()
		followConnection = nil
	end
	if autoTpButton then
		autoTpButton.Text = "FOLLOW: OFF"
		autoTpButton.BackgroundColor3 = GRAY
	end
end

local function stopSpectate()
	spectating = false
	local humanoid = getHumanoid(LP)
	if humanoid and workspace.CurrentCamera then
		workspace.CurrentCamera.CameraSubject = humanoid
	end
	if spectateButton then
		spectateButton.Text = "SPECTATE: OFF"
		spectateButton.BackgroundColor3 = GRAY
	end
end

local function stopCamLock()
	camLockEnabled = false
	if camLockConnection then
		camLockConnection:Disconnect()
		camLockConnection = nil
	end
	if camLockButton then
		camLockButton.Text = "CAM LOCK: OFF"
		camLockButton.BackgroundColor3 = GRAY
	end
end

local function stopFly()
	flyEnabled = false
	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end
	
	local myRoot = getRoot(LP)
	if myRoot then
		if myRoot:FindFirstChild("KD5_FlyBV") then myRoot.KD5_FlyBV:Destroy() end
		if myRoot:FindFirstChild("KD5_FlyBG") then myRoot.KD5_FlyBG:Destroy() end
	end
	
	local myHum = getHumanoid(LP)
	if myHum then
		myHum.PlatformStand = false
	end

	if flyButton then
		flyButton.Text = "FLY: OFF"
		flyButton.BackgroundColor3 = GRAY
	end
end

local function clearTarget()
	stopFollow()
	stopSpectate()
	stopCamLock()
	clearHighlight()
	selectedPlayer = nil
end

--====================================================
-- HIGHLIGHT & ESP
--====================================================

local function updateHighlight()
	clearHighlight()

	if not selectedPlayer or not selectedPlayer.Character then return end

	targetHighlight = Instance.new("Highlight")
	targetHighlight.Name = "KD5_TargetHighlight"
	targetHighlight.FillColor = WHITE
	targetHighlight.OutlineColor = WHITE
	targetHighlight.FillTransparency = 0.85
	targetHighlight.OutlineTransparency = 0
	targetHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	targetHighlight.Parent = selectedPlayer.Character
end

local function updateESP()
	-- Clear Old ESP
	for plr, hl in pairs(espObjects) do
		if hl then hl:Destroy() end
	end
	table.clear(espObjects)

	if not espEnabled then return end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LP and player.Character then
			local hl = Instance.new("Highlight")
			hl.Name = "KD5_ESP"
			hl.FillColor = (player == selectedPlayer) and RED_ACCENT or GREEN_ACCENT
			hl.OutlineColor = WHITE
			hl.FillTransparency = 0.6
			hl.OutlineTransparency = 0
			hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			hl.Parent = player.Character
			
			espObjects[player] = hl
		end
	end
end

