-- Thông báo
local function Notify(title, desc, duration)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title or "CHU NGOC BEO",
            Text = desc or "",
            Duration = duration or 5,
        })
    end)
end

-- Hàm bảo vệ UI
local function Protect(gui)
    local env = (getgenv and getgenv()) or _G
    if env.HIDEUI then
        gui.Parent = env.HIDEUI
    elseif gethui then
        gui.Parent = gethui()
    elseif syn and syn.protect_gui then
        syn.protect_gui(gui)
        gui.Parent = CoreGui
    else
        gui.Parent = CoreGui
    end
end

-- Tạo nút bấm nổi KD5 bật/tắt Menu
local function CreateKD5Button()
    local SG = Instance.new("ScreenGui")
    SG.Name = "CHUNGOCBEO_KD5_TOGGLE"
    SG.ResetOnSpawn = false
    Protect(SG)

    local ToggleBtn = Instance.new("TextButton")
    ToggleBtn.Name = "KD5Button"
    ToggleBtn.Size = UDim2.new(0, 55, 0, 55)
    ToggleBtn.Position = UDim2.new(0, 15, 0.4, 0)
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    ToggleBtn.Text = "KD5"
    ToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 150)
    ToggleBtn.TextSize = 16
    ToggleBtn.Font = Enum.Font.FredokaOne
    ToggleBtn.Active = true
    ToggleBtn.Draggable = true
    ToggleBtn.Parent = SG

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 12)
    Corner.Parent = ToggleBtn

    local Stroke = Instance.new("UIStroke")
    Stroke.Color = Color3.fromRGB(0, 255, 150)
    Stroke.Thickness = 2
    Stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    Stroke.Parent = ToggleBtn

    -- Sự kiện ẩn/hiện GUI khi bấm nút KD5 hoặc phím KD5 (Keypad 5)
    local function ToggleMenu()
        local VirtualInputManager = game:GetService("VirtualInputManager")
        -- Giả lập nhấn phím RightControl/Keypad5 để đóng/mở Menu chính của script
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.RightControl, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.RightControl, false, game)
    end

    ToggleBtn.MouseButton1Click:Connect(ToggleMenu)

    UserInputService.InputBegan:Connect(function(input, processed)
        if not processed and (input.KeyCode == Enum.KeyCode.KeypadFive or input.KeyCode == Enum.KeyCode.Five) then
            ToggleMenu()
        end
    end)
end

-- Hàm chạy Script
local function ExecuteScript()
    Notify("CHU NGOC BEO", "Đang kích hoạt bản Full Chức Năng...", 4)
    
    local scriptUrl = Scripts.Premium[gameId] or Scripts.Free[gameId]
    
    if scriptUrl then
        local ok, err = pcall(function()
            loadstring(game:HttpGet(scriptUrl))()
        end)
        
        if ok then
            CreateKD5Button()
            Notify("CHU NGOC BEO", "Kích hoạt thành công! Bấm nút KD5 để bật/tắt Menu.", 6)
        else
            warn("[CHU NGOC BEO] Lỗi tải Script: " .. tostring(err))
            Notify("Lỗi CHU NGOC BEO", "Không thể tải Script cho game này.", 5)
        end
    else
        Notify("CHU NGOC BEO", "Game hiện tại chưa được hỗ trợ!", 5)
    end
end

-- Chạy trực tiếp không qua Key System
ExecuteScript()
