local Q = loadstring(game:HttpGet("https://raw.githubusercontent.com/flazhy/QuantumOnyx/refs/heads/main/QuantumOnyx.lua"))()
local T = Q:MakeWindow({Name="KD5 Hub",SubTitle=""}):MakeTab({Name="Target"})
local P,RS,LP = game:GetService("Players"),game:GetService("RunService"),game:GetService("Players").LocalPlayer
local Tgt,F,B,N,H

local function R(p) return p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") end
local function getP() local t={} for _,v in P:GetPlayers() do if v~=LP then table.insert(t,v.Name) end end return t end

local D = T:AddDropdown({Name="Target",Options=getP(),Callback=function(v)
    Tgt = P:FindFirstChild(v)
    if H then H:Destroy() end
    if Tgt and Tgt.Character then H = Instance.new("Highlight",Tgt.Character) H.FillTransparency = 0.8 end
end})

P.PlayerAdded:Connect(function() D:SetOptions(getP()) end)
P.PlayerRemoving:Connect(function(p) if p==Tgt then Tgt=nil end D:SetOptions(getP()) end)

T:AddButton({Name="Teleport",Callback=function() local r1,r2=R(LP),R(Tgt) if r1 and r2 then r1.CFrame=r2.CFrame*CFrame.new(0,0,3) end end})
T:AddToggle({Name="Spectate",Callback=function(v) workspace.CurrentCamera.CameraSubject = v and Tgt and Tgt.Character and Tgt.Character:FindFirstChildOfClass("Humanoid") or LP.Character:FindFirstChildOfClass("Humanoid") end})
T:AddToggle({Name="Follow",Callback=function(v) F=v end})
T:AddToggle({Name="Bring",Callback=function(v) B=v end})
T:AddToggle({Name="Noclip",Callback=function(v) N=v end})

RS.Heartbeat:Connect(function()
    local r1,r2 = R(LP),R(Tgt)
    if r1 and r2 then
        if F then r1.CFrame = r2.CFrame * CFrame.new(0,0,3) end
        if B then r2.CFrame = r1.CFrame * CFrame.new(0,0,-3) end
    end
    if N and LP.Character then for _,p in LP.Character:GetDescendants() do if p:IsA("BasePart") then p.CanCollide=false end end end
end)
