local AutoClickerEnabled = false
local MacroComboEnabled = false
local MacroDelay = 0.2

task.spawn(function()
    while task.wait(0.05) do
        if AutoClickerEnabled then
            pcall(function()
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                task.wait(0.01)
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end)
        end
    end
end)

task.spawn(function()
    while task.wait(0.1) do
        if MacroComboEnabled then
            pcall(function()
                local comboKeys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
                for _, key in ipairs(comboKeys) do
                    if not MacroComboEnabled then break end
                    VirtualInputManager:SendKeyEvent(true, key, false, game)
                    task.wait(MacroDelay)
                    VirtualInputManager:SendKeyEvent(false, key, false, game)
                    task.wait(MacroDelay)
                end
            end)
        end
    end
end)

