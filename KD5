local Q = loadstring(game:HttpGet("https://raw.githubusercontent.com/flazhy/QuantumOnyx/refs/heads/main/QuantumOnyx.lua"))()
local Win = Q:MakeWindow({Name = "Quantum Universal", SubTitle = "All-In-One Hub"})

local P, RS, UIS = game:GetService("Players"), game:GetService("RunService"), game:GetService("UserInputService")
local LP = P.LocalPlayer
local Cam = workspace.CurrentCamera

-- Cấu hình trạng thái tính năng
local Config = {
    Aimbot = false,
    HoldRMB = true,
    AimPart = "Head",
    Fly = false,
    FlySpeed = 50,
    InfJump = false,
    Noclip = false,
    Speed = 16,
    ESP = false
}

-- Khởi tạo Tabs
local CombatTab = Win:MakeTab({Name = "Combat"})
local MovementTab = Win:MakeTab({Name = "Movement"})
local VisualsTab = Win:MakeTab({Name = "Visuals"})

-- TAB COMBAT
CombatTab:AddToggle({Name = "Enable Aimbot", Callback = function(v) Config.Aimbot = v end})
CombatTab:AddToggle({Name = "Hold Right Click to Aim", Default = true, Callback = function(v) Config.HoldRMB = v end})
CombatTab:AddDropdown({
    Name = "Aim Part",
    Options = {"Head", "HumanoidRootPart"},
    Callback = function(v) Config.AimPart = v end
})

-- TAB MOVEMENT (Thêm Fly & Infinite Jump)
MovementTab:AddToggle({Name = "Fly (Bay)", Callback = function(v) Config.Fly = v end})
MovementTab:AddSlider({
    Name = "Fly Speed",
    Min = 10, Max = 300, Default = 50,
    Callback = function(v) Config.FlySpeed = v end
})
MovementTab:AddToggle({Name = "Infinite Jump (Nhảy vô hạn)", Callback = function(v) Config.InfJump = v end})
MovementTab:AddToggle({Name = "Noclip", Callback = function(v) Config.Noclip = v end})
MovementTab:AddSlider({
    Name = "WalkSpeed",
    Min = 16, Max = 250, Default = 16,
    Callback = function(v) Config.Speed = v end
})

-- TAB VISUALS
VisualsTab:AddToggle({Name = "Player ESP", Callback = function(v) Config.ESP = v end})

-- Logic Infinite Jump (Bắt sự kiện bấm nút Nhảy)
UIS.JumpRequest:Connect(function()
    if Config.InfJump and LP.Character then
        local hum = LP.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

-- Hàm tìm người chơi gần tâm ngắm nhất
local function getClosestPlayer()
    local target, minDist = nil, math.huge
    for _, p in ipairs(P:GetPlayers()) do
        if p ~= LP and p.Character and p.Character:FindFirstChild(Config.AimPart) then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local pos, onScreen = Cam:WorldToViewportPoint(p.Character[Config.AimPart].Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2)).Magnitude
                    if dist < minDist then
                        minDist = dist
                        target = p
                    end
                end
            end
        end
    end
    return target
end

-- Luồng xử lý RenderStepped chính
RS.RenderStepped:Connect(function()
    -- 1. Logic Aimbot (Giữ chuột phải)
    local isRMBHeld = UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    if Config.Aimbot and (not Config.HoldRMB or isRMBHeld) then
        local target = getClosestPlayer()
        if target and target.Character and target.Character:FindFirstChild(Config.AimPart) then
            Cam.CFrame = CFrame.lookAt(Cam.CFrame.Position, target.Character[Config.AimPart].Position)
        end
    end

    -- 2. Logic Character (WalkSpeed, Noclip, Fly)
    if LP.Character then
        local root = LP.Character:FindFirstChild("HumanoidRootPart")
        local hum = LP.Character:FindFirstChildOfClass("Humanoid")

        if hum then hum.WalkSpeed = Config.Speed end

        -- Noclip
        if Config.Noclip then
            for _, part in ipairs(LP.Character:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end

        -- Fly Logic (Dùng các phím WASD + Space để lên / LeftShift để xuống)
        if Config.Fly and root and hum then
            hum.PlatformStand = true
            local moveDir = Vector3.zero
            if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, 1, 0) end

            root.Velocity = moveDir * Config.FlySpeed
        else
            if hum and hum.PlatformStand then hum.PlatformStand = false end
        end
    end

    -- 3. Logic Player ESP
    for _, p in ipairs(P:GetPlayers()) do
        if p ~= LP and p.Character then
            local hl = p.Character:FindFirstChild("QuantumESP")
            if Config.ESP then
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "QuantumESP"
                    hl.FillTransparency = 0.5
                    hl.OutlineColor = Color3.fromRGB(255, 0, 0)
                    hl.Parent = p.Character
                end
            else
                if hl then hl:Destroy() end
            end
        end
    end
end)
